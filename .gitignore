# =====================================================
# .gitignore for a Static Portfolio Website
# =====================================================

# ----- OS & System Files -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ----- Editor & IDE Files -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ----- Temporary & Log Files -----
*.log
*.tmp
*.temp
*.bak
*.orig

# ----- Node (not used, but just in case) -----
node_modules/
npm-debug.log*
yarn-error.log
package-lock.json
yarn.lock

# ----- Build Output (not used, but just in case) -----
dist/
build/
.cache/

# ----- Sensitive / Private -----
.env
.env.*
secrets.*
